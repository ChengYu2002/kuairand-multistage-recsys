# Data (never commit raw / processed KuaiRand logs)
data/raw/*
data/processed/*
data/cache/*
!data/**/.gitkeep

# Papers / reading material (版权原因不入库)
literatures/

# Experiment outputs
experiments/*
results/*
!experiments/.gitkeep
!results/.gitkeep
# 预测文件是证据不是产物：README 的事后对账表直接引用它们，必须可核对。
!results/*_prediction.json
*.ckpt
*.pt
*.pth
*.faiss
wandb/
mlruns/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Personal learning notes
/note/

# 本地临时产物（训练日志、PDF 预览等）。**里面可能有个人文件**，
# 不加这条的话一次 `git add -A` 就会把它们提交进公开仓库。
tmp/
